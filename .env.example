# 文本模型：当前支持 OpenAI chat/completions 兼容接口
# 必填：TEXT_API_KEY、TEXT_MODEL
# TEXT_BASE_URL 留空时使用 OpenAI SDK 默认地址；其他平台请填写其兼容地址
TEXT_PROVIDER=openai_compatible
TEXT_API_KEY=
TEXT_BASE_URL=
TEXT_MODEL=
TEXT_TIMEOUT=120
# auto：不支持 response_format 时自动退回普通 JSON 提示
# required：必须支持 response_format；disabled：从不发送 response_format
TEXT_JSON_MODE=auto

# 视频模型：v0.6.0 当前只实现 Agnes，且仅在用户确认付费生成后使用
VIDEO_PROVIDER=agnes
VIDEO_API_KEY=
VIDEO_API_ROOT=https://apihub.agnes-ai.com
VIDEO_MODEL=agnes-video-v2.0
VIDEO_TIMEOUT=120
VIDEO_POLL_INTERVAL=5
VIDEO_MAX_POLL_SECONDS=900

NARRATION_VOICE=zh-CN-XiaoxiaoNeural
VIDEO_OUTPUT_DIR=outputs/videos
# Web 上传的参考图会复制到这个私有目录；默认位于已忽略的 outputs 下。
VISUAL_INPUT_DIR=outputs/visual_inputs
# 可选：仅当这个本地目录已经由你自己的静态服务器/CDN公开托管时填写。
# 两项必须同时填写。项目会把当前任务需要的单张首帧/末帧原子暂存到该目录，
# 不会公开 VIDEO_OUTPUT_DIR、整个仓库，也不会替你配置或上传到静态服务器/CDN。
# VIDEO_OUTPUT_DIR 可以位于公开根目录之外。
# VIDEO_REFERENCE_ROOT=V:/path/to/public/video-assets
# VIDEO_REFERENCE_BASE_URL=https://cdn.example.com/video-assets

# 旧版 DEEPSEEK_* / AGNES_* 配置仍可读取，但新配置优先。
