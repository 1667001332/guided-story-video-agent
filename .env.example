# 故事与剧本文本模型（DeepSeek，必填项只有 API Key）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEXT_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT=120

# 当前视频生成 Provider（仅在确认付费生成后使用）
AGNES_API_KEY=
AGNES_API_ROOT=https://apihub.agnes-ai.com
AGNES_VIDEO_MODEL=agnes-video-v2.0
AGNES_TIMEOUT=120
AGNES_POLL_INTERVAL=5
AGNES_MAX_POLL_SECONDS=900

NARRATION_VOICE=zh-CN-XiaoxiaoNeural
VIDEO_OUTPUT_DIR=outputs/videos
